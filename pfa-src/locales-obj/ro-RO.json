  },
  {
    "$i": "about_desc",
    "$v": "Un vizualizator MIDI optimizat pentru telefoanele inteligente (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Se concentrează pe o conductă de randare Canvas optimizată pentru a afișa fără probleme melodiile Black MIDI de înaltă densitate pe hardware limitat."
  },
  {
    "$i": "about_features_title",
    "$v": "Caracteristici cheie"
  },
  {
    "$i": "about_f1",
    "$v": "Optimizare MIDI neagră - algoritmii ușori gestionează zeci de mii de note fără scăderi severe ale FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Suport pentru tastatură fizică - navigare lină prin D-Pad și tastele numerice."
  },
  {
    "$i": "about_f3",
    "$v": "Extrem de personalizabil - afișaj complet pentru pian cu 128 de taste, culori personalizabile ale pieselor, viteze reglabile de cădere a notelor."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - sintetizatorul ușor încorporat minimizează utilizarea RAM pe dispozitivele de gamă inferioară."
  },
  {
    "$i": "about_keys_title",
    "$v": "Chei"
  },
  {
    "$i": "about_k1",
    "$v": "< > căutare ±1s • ^ v volum • OK redare/pauză"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x viteză • 2 mod de randare • 3 -0,1x viteză • 4 rotire"
  },
  {
    "$i": "about_k3",
    "$v": "5 încărcare MIDI • 6 fullscreen • 7 taste 88-128"
  },
  {
    "$i": "about_k4",
