    "$i": "about_version",
    "$v": "Versione 1.0.1 • KaiOS 2.5 • Supporto MIDI nero • Licenza MIT"
  },
  {
    "$i": "about_desc",
    "$v": "Un visualizzatore MIDI ottimizzato per telefoni intelligenti (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Si concentra su una pipeline di rendering Canvas ottimizzata per visualizzare senza problemi tracce MIDI nere ad alta densità su hardware limitato."
  },
  {
    "$i": "about_features_title",
    "$v": "Caratteristiche principali"
  },
  {
    "$i": "about_f1",
    "$v": "Ottimizzazione MIDI nera: algoritmi leggeri gestiscono decine di migliaia di note senza gravi cali di FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Supporto tastiera fisica: navigazione fluida tramite D-Pad e tasti numerici."
  },
  {
    "$i": "about_f3",
    "$v": "Altamente personalizzabile: display completo del pianoforte a 128 tasti, colori delle tracce personalizzabili, velocità di caduta delle note regolabile."
  },
  {
    "$i": "about_f4",
    "$v": "Sintetizzatore WebAudio: il sintetizzatore leggero integrato riduce al minimo l'utilizzo della RAM sui dispositivi di fascia bassa."
  },
  {
    "$i": "about_keys_title",
    "$v": "Chiavi"
  },
  {
    "$i": "about_k1",
    "$v": "< > ricerca ±1s • ^ v volume • OK riproduci/pausa"
  },
  {
    "$i": "about_k2",
    "$v": "1 velocità +0,1x • 2 modalità rendering • 3 velocità -0,1x • 4 rotazione"
  },
  {
    "$i": "about_k3",
    "$v": "5 carica MIDI • 6 a schermo intero • 7 tasti 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 MIDI cancellati (libera RAM) • 9 dimensioni pianoforte • 0 stop"
  },
  {
    "$i": "about_k5",
    "$v": "Scheda informativa chiamata • * traccia -0,1 • # traccia +0,1 • Fine chiamata esci"
  },
  {
    "$i": "about_credits_title",
    "$v": "Crediti"
  },
  {
    "$i": "about_c1",
    "$v": "Sviluppato da T.Hoang"
  },
