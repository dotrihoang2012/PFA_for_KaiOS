    "$i": "about_version",
    "$v": "Version 1.0.1 • KaiOS 2.5 • Sort MIDI understøttet • MIT-licens"
  },
  {
    "$i": "about_desc",
    "$v": "En MIDI-visualizer optimeret til smarttelefoner (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Fokuserer på en optimeret Canvas-gengivelsespipeline for jævnt at vise sorte MIDI-spor med høj tæthed på begrænset hardware."
  },
  {
    "$i": "about_features_title",
    "$v": "Nøglefunktioner"
  },
  {
    "$i": "about_f1",
    "$v": "Sort MIDI-optimering - lette algoritmer håndterer titusindvis af noder uden alvorlige FPS-fald."
  },
  {
    "$i": "about_f2",
    "$v": "Understøttelse af fysisk tastatur - jævn navigation via D-Pad og taltaster."
  },
  {
    "$i": "about_f3",
    "$v": "Meget tilpasselig - komplet klaverdisplay med 128 tangenter, sporfarver, der kan tilpasses, justerbar nodefaldshastighed."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - indbygget letvægtssynth minimerer RAM-forbruget på enheder i den lave ende."
  },
  {
    "$i": "about_keys_title",
    "$v": "Nøgler"
  },
  {
    "$i": "about_k1",
    "$v": "< > søg ±1s • ^ v lydstyrke • OK afspil/pause"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x hastighed • 2 gengivelsestilstand • 3 -0,1x hastighed • 4 rotationer"
  },
  {
    "$i": "about_k3",
    "$v": "5 indlæs MIDI • 6 fuldskærm • 7 tangenter 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 klare MIDI (frigør RAM) • 9 klaverstørrelse • 0 stop"
  },
  {
    "$i": "about_k5",
    "$v": "Opkaldsinfokort • * spor -0,1 • # spor +0,1 • Afslut opkald"
  },
  {
    "$i": "about_credits_title",
