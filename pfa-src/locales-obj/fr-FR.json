    "$i": "about_version",
    "$v": "Version 1.0.1 • KaiOS 2.5 • Black MIDI pris en charge • Licence MIT"
  },
  {
    "$i": "about_desc",
    "$v": "Un visualiseur MIDI optimisé pour les téléphones intelligents (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Se concentre sur un pipeline de rendu Canvas optimisé pour afficher en douceur les pistes Black MIDI haute densité sur du matériel contraint."
  },
  {
    "$i": "about_features_title",
    "$v": "Principales fonctionnalités"
  },
  {
    "$i": "about_f1",
    "$v": "Black MIDI Optimization - des algorithmes légers gèrent des dizaines de milliers de notes sans chutes sévères de FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Prise en charge du clavier physique - navigation fluide via le D-Pad et les touches numériques."
  },
  {
    "$i": "about_f3",
    "$v": "Hautement personnalisable : écran de piano complet à 128 touches, couleurs de piste personnalisables, vitesses de chute des notes réglables."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - un synthétiseur léger intégré minimise l'utilisation de la RAM sur les appareils bas de gamme."
  },
  {
    "$i": "about_keys_title",
    "$v": "Clés"
  },
  {
    "$i": "about_k1",
    "$v": "< > recherche ±1s • ^ v volume • OK lecture/pause"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x vitesse • 2 modes de rendu • 3 -0,1x vitesse • 4 rotation"
  },
  {
    "$i": "about_k3",
    "$v": "5 chargement MIDI • 6 plein écran • 7 touches 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 MIDI clairs (libère la RAM) • 9 tailles de piano • 0 stop"
  },
  {
    "$i": "about_k5",
    "$v": "Carte d'informations sur l'appel • * trail -0,1 • # trail +0,1 • Fin d'appel quittant"
  },
  {
    "$i": "about_credits_title",
