    "$i": "about_version",
    "$v": "Verzia 1.0.1 • KaiOS 2.5 • Podpora čierneho MIDI • Licencia MIT"
  },
  {
    "$i": "about_desc",
    "$v": "MIDI vizualizér optimalizovaný pre inteligentné telefóny (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Zameriava sa na optimalizovaný kanál vykresľovania Canvas, aby plynulo zobrazoval čierne MIDI stopy s vysokou hustotou na obmedzenom hardvéri."
  },
  {
    "$i": "about_features_title",
    "$v": "Kľúčové vlastnosti"
  },
  {
    "$i": "about_f1",
    "$v": "Black MIDI Optimization – ľahké algoritmy zvládajú desaťtisíce tónov bez výrazných poklesov FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Podpora fyzickej klávesnice – plynulá navigácia cez D-Pad a číselné klávesy."
  },
  {
    "$i": "about_f3",
    "$v": "Vysoko prispôsobiteľné - plný 128-klávesový klavírny displej, prispôsobiteľné farby stôp, nastaviteľná rýchlosť padania nôt."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - vstavaný ľahký syntetizátor minimalizuje využitie RAM na zariadeniach nižšej kategórie."
  },
  {
    "$i": "about_keys_title",
    "$v": "Kľúče"
  },
  {
    "$i": "about_k1",
    "$v": "< > vyhľadávanie ±1s • ^ v hlasitosť • OK prehrávanie/pozastavenie"
  },
  {
    "$i": "about_k2",
