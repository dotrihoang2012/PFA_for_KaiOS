  {
    "$i": "about_desc",
    "$v": "Nutitelefonide jaoks optimeeritud MIDI-visualisaator (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Keskendub optimeeritud lõuendi renderduskonveierile, et kuvada sujuvalt kõrge tihedusega musti MIDI lugusid piiratud riistvaras."
  },
  {
    "$i": "about_features_title",
    "$v": "Põhifunktsioonid"
  },
  {
    "$i": "about_f1",
    "$v": "Must MIDI optimeerimine – kerged algoritmid käsitlevad kümneid tuhandeid noote ilma tõsiste FPS-i langusteta."
  },
  {
    "$i": "about_f2",
    "$v": "Füüsilise klahvistiku tugi – sujuv navigeerimine D-Padi ja numbriklahvide kaudu."
  },
  {
    "$i": "about_f3",
    "$v": "Väga kohandatav - täielik 128-klahviline klaveriekraan, kohandatavad palavärvid, reguleeritavad noodi langemiskiirused."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio süntesaator – sisseehitatud kerge süntesaator minimeerib RAM-i kasutust madala kvaliteediga seadmetes."
  },
  {
    "$i": "about_keys_title",
    "$v": "Võtmed"
  },
  {
    "$i": "about_k1",
    "$v": "< > otsi ±1 s • ^ v helitugevus • OK esitus/paus"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x kiirus • 2 renderdusrežiim • 3 -0,1x kiirus • 4 pööramine"
  },
  {
    "$i": "about_k3",
    "$v": "5 laadi MIDI • 6 täisekraani • 7 klahvi 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 selge MIDI (vabastab RAM) • 9 klaveri suurus • 0 stop"
  },
  {
    "$i": "about_k5",
