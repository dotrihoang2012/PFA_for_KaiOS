    "$i": "about_version",
    "$v": "Útgáfa 1.0.1 • KaiOS 2.5 • Styður svartur MIDI • MIT leyfi"
  },
  {
    "$i": "about_desc",
    "$v": "MIDI sjóntæki sem er fínstillt fyrir snjallsíma (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Einbeitir sér að fínstilltri Canvas flutningsleiðslu til að sýna mjúklega svarta MIDI lög með miklum þéttleika á þvinguðum vélbúnaði."
  },
  {
    "$i": "about_features_title",
    "$v": "Helstu eiginleikar"
  },
  {
    "$i": "about_f1",
    "$v": "Black MIDI Optimization - létt reiknirit höndla tugþúsundir nóta án alvarlegra FPS falla."
  },
  {
    "$i": "about_f2",
    "$v": "Stuðningur við líkamlegt lyklaborð - slétt leiðsögn með D-Pad og tölutökkum."
  },
  {
    "$i": "about_f3",
    "$v": "Mjög sérhannaðar - fullur 128 takka píanóskjár, sérhannaðar lagalitir, stillanlegur fallhraði nótna."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - innbyggður léttur hljóðgervill lágmarkar vinnsluminni notkun á lágum tækjum."
  },
  {
    "$i": "about_keys_title",
    "$v": "Lyklar"
  },
  {
    "$i": "about_k1",
    "$v": "< > leita ±1s • ^ v hljóðstyrkur • Í lagi spila/hlé"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x hraði • 2 flutningshamur • 3 -0,1x hraði • 4 snúningur"
  },
  {
    "$i": "about_k3",
    "$v": "5 hlaða MIDI • 6 fullskjár • 7 takkar 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 clear MIDI (fríar vinnsluminni) • 9 píanó stærð • 0 stopp"
  },
  {
    "$i": "about_k5",
    "$v": "Símtalsupplýsingaspjald • * slóð -0,1 • # slóð +0,1 • Hætta á símtali"
