    "$i": "about_version",
    "$v": "Sürüm 1.0.1 • KaiOS 2.5 • Siyah MIDI destekli • MIT Lisansı"
  },
  {
    "$i": "about_desc",
    "$v": "Akıllı özellikli telefonlar (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...) için optimize edilmiş bir MIDI görselleştirici. Kısıtlı donanımlarda yüksek yoğunluklu Siyah MIDI parçalarını sorunsuz bir şekilde görüntülemek için optimize edilmiş bir Canvas işleme hattına odaklanır."
  },
  {
    "$i": "about_features_title",
    "$v": "Temel Özellikler"
  },
  {
    "$i": "about_f1",
    "$v": "Siyah MIDI Optimizasyonu - hafif algoritmalar, ciddi FPS düşüşleri olmadan on binlerce notayı işler."
  },
  {
    "$i": "about_f2",
    "$v": "Fiziksel Tuş Takımı Desteği - D-Pad ve sayı tuşlarıyla sorunsuz gezinme."
  },
  {
    "$i": "about_f3",
    "$v": "Son Derece Özelleştirilebilir - tam 128 tuşlu piyano ekranı, özelleştirilebilir parça renkleri, ayarlanabilir nota düşme hızları."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - yerleşik hafif sentez, düşük kaliteli cihazlarda RAM kullanımını en aza indirir."
  },
  {
    "$i": "about_keys_title",
    "$v": "Anahtarlar"
  },
  {
    "$i": "about_k1",
    "$v": "< > arama ±1s • ^ v ses seviyesi • Tamam oynat/duraklat"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x hız • 2 işleme modu • 3 -0,1x hız • 4 döndürme"
  },
  {
    "$i": "about_k3",
    "$v": "5 yükleme MIDI • 6 tam ekran • 7 tuş 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 net MIDI (RAM'i serbest bırakır) • 9 piyano boyutu • 0 durak"
  },
  {
    "$i": "about_k5",
    "$v": "Çağrı bilgi kartı • * iz -0,1 • # iz +0,1 • Çağrıyı sonlandır"
  },
  {
    "$i": "about_credits_title",
    "$v": "Krediler ve Katkıda Bulunma"
  },
  {
    "$i": "about_c1",
