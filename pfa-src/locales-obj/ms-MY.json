    "$i": "about_version",
    "$v": "Versi 1.0.1 • KaiOS 2.5 • MIDI Hitam disokong • Lesen MIT"
  },
  {
    "$i": "about_desc",
    "$v": "Visualizer MIDI yang dioptimumkan untuk telefon ciri pintar (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Memfokuskan pada saluran paip pemaparan Kanvas yang dioptimumkan untuk memaparkan dengan lancar trek MIDI Hitam berketumpatan tinggi pada perkakasan yang dikekang."
  },
  {
    "$i": "about_features_title",
    "$v": "Ciri-ciri Utama"
  },
  {
    "$i": "about_f1",
    "$v": "Pengoptimuman MIDI Hitam - algoritma ringan mengendalikan puluhan ribu nota tanpa penurunan FPS yang teruk."
  },
  {
    "$i": "about_f2",
    "$v": "Sokongan Papan Kekunci Fizikal - navigasi lancar melalui D-Pad dan kekunci nombor."
  },
  {
    "$i": "about_f3",
    "$v": "Sangat Boleh Disesuaikan - paparan piano penuh 128 kekunci, warna trek boleh disesuaikan, kelajuan jatuh nota boleh laras."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - synth ringan terbina dalam meminimumkan penggunaan RAM pada peranti rendah."
  },
  {
    "$i": "about_keys_title",
    "$v": "kunci"
  },
  {
    "$i": "about_k1",
    "$v": "< > cari ±1s • ^ v kelantangan • OK main/jeda"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0.1x kelajuan • 2 mod paparan • 3 -0.1x kelajuan • 4 putaran"
  },
  {
    "$i": "about_k3",
    "$v": "5 muatkan MIDI • 6 skrin penuh • 7 kekunci 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 MIDI yang jelas (membebaskan RAM) • 9 saiz piano • 0 hentian"
  },
  {
    "$i": "about_k5",
    "$v": "Kad maklumat panggilan • * jejak -0.1 • # jejak +0.1 • Tamat panggilan berhenti"
