  {
    "$i": "about_version",
    "$v": "1.0.1 нұсқасы • KaiOS 2.5 • Қара MIDI қолдауы бар • MIT лицензиясы"
  },
  {
    "$i": "about_desc",
    "$v": "Смарт функциялы телефондар үшін оңтайландырылған MIDI визуализаторы (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Шектеулі аппараттық құралда жоғары тығыздықтағы қара MIDI тректерін біркелкі көрсету үшін оңтайландырылған Canvas көрсету құбырына назар аударады."
  },
  {
    "$i": "about_features_title",
    "$v": "Негізгі мүмкіндіктер"
  },
  {
    "$i": "about_f1",
    "$v": "Қара MIDI оңтайландыруы - жеңіл алгоритмдер FPS қатты төмендеуінсіз ондаған мың ноталарды өңдейді."
  },
  {
    "$i": "about_f2",
    "$v": "Физикалық пернетақтаны қолдау - D-Pad және сандық пернелер арқылы тегіс шарлау."
  },
  {
    "$i": "about_f3",
    "$v": "Жоғары теңшелетін - толық 128 перне фортепиано дисплейі, реттелетін трек түстері, реттелетін нотаның түсу жылдамдығы."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - кірістірілген жеңіл синтез төмен деңгейлі құрылғыларда жедел жадты пайдалануды азайтады."
  },
  {
    "$i": "about_keys_title",
    "$v": "Кілттер"
  },
  {
    "$i": "about_k1",
    "$v": "< > іздеу ±1с • ^ v дыбыс деңгейі • OK ойнату/кідірту"
  },
