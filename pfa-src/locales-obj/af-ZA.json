  },
  {
    "$i": "about_f2",
    "$v": "Fisiese sleutelbordondersteuning - gladde navigasie via D-Pad en nommersleutels."
  },
  {
    "$i": "about_f3",
    "$v": "Hoogs aanpasbaar - volledige klaviervertoning van 128 sleutels, aanpasbare snitkleure, verstelbare nootvalspoed."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - ingeboude liggewig synth verminder RAM-gebruik op lae-end toestelle."
