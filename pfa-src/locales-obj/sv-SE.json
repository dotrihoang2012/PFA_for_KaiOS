  },
  {
    "$i": "about_desc",
    "$v": "En MIDI-visualiserare optimerad för smarta funktionstelefoner (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Fokuserar på en optimerad Canvas-renderingspipeline för att smidigt visa svarta MIDI-spår med hög densitet på begränsad hårdvara."
  },
  {
    "$i": "about_features_title",
    "$v": "Nyckelfunktioner"
  },
  {
    "$i": "about_f1",
    "$v": "Svart MIDI-optimering - lätta algoritmer hanterar tiotusentals toner utan allvarliga FPS-fall."
  },
  {
    "$i": "about_f2",
    "$v": "Stöd för fysisk knappsats - smidig navigering via D-Pad och sifferknappar."
  },
  {
    "$i": "about_f3",
    "$v": "Mycket anpassningsbar - full pianodisplay med 128 tangenter, anpassningsbara spårfärger, justerbar notfallshastighet."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - inbyggd lättviktssynth minimerar RAM-användningen på enkla enheter."
  },
  {
    "$i": "about_keys_title",
    "$v": "Nycklar"
  },
