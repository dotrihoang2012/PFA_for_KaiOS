    "$i": "about_version",
    "$v": "Versión 1.0.1 • KaiOS 2.5 • Compatible con Black MIDI • Licencia MIT"
  },
  {
    "$i": "about_desc",
    "$v": "Un visualizador MIDI optimizado para teléfonos inteligentes (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Se centra en un canal de renderizado de Canvas optimizado para mostrar sin problemas pistas Black MIDI de alta densidad en hardware limitado."
  },
  {
    "$i": "about_features_title",
    "$v": "Características clave"
  },
  {
    "$i": "about_f1",
    "$v": "Black MIDI Optimization: algoritmos livianos manejan decenas de miles de notas sin caídas severas de FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Compatibilidad con teclado físico: navegación fluida mediante el D-Pad y las teclas numéricas."
  },
  {
    "$i": "about_f3",
    "$v": "Altamente personalizable: pantalla de piano completa de 128 teclas, colores de pista personalizables y velocidades de caída de notas ajustables."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer: el sintetizador liviano incorporado minimiza el uso de RAM en dispositivos de gama baja."
  },
  {
    "$i": "about_keys_title",
    "$v": "llaves"
  },
  {
    "$i": "about_k1",
    "$v": "< > buscar ±1s • ^ v volumen • OK reproducir/pausar"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x de velocidad • 2 modo de renderizado • 3 -0,1x de velocidad • 4 rotar"
  },
  {
    "$i": "about_k3",
    "$v": "5 cargar MIDI • 6 pantalla completa • 7 teclas 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 borrar MIDI (libera RAM) • 9 tamaño de piano • 0 parada"
  },
  {
    "$i": "about_k5",
    "$v": "Tarjeta de información de llamada • * rastro -0.1 • # rastro +0.1 • Finalizar llamada salir"
  },
  {
    "$i": "about_credits_title",
    "$v": "Créditos"
  },
  {
    "$i": "about_c1",
    "$v": "Desarrollado por T.Hoang"
  },
  {
    "$i": "about_c2",
    "$v": "Los RP son bienvenidos: bifurcación -> rama de características -> confirmar -> empujar -> Solicitud de extracción"
  },
  {
    "$i": "about_src",
