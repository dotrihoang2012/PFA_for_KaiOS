    "$i": "about_version",
    "$v": "Versio 1.0.1 • KaiOS 2.5 • Musta MIDI tuettu • MIT-lisenssi"
  },
  {
    "$i": "about_desc",
    "$v": "MIDI-visualisoija, joka on optimoitu älypuhelimille (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Keskittyy optimoituun Canvas-renderöintiputkilinjaan, joka näyttää sujuvasti tiheät mustat MIDI-kappaleet rajoitetuilla laitteistoilla."
  },
  {
    "$i": "about_features_title",
    "$v": "Tärkeimmät ominaisuudet"
  },
  {
    "$i": "about_f1",
    "$v": "Black MIDI Optimization - kevyet algoritmit käsittelevät kymmeniä tuhansia nuotteja ilman vakavia FPS-pudotuksia."
  },
  {
    "$i": "about_f2",
    "$v": "Fyysisen näppäimistön tuki - sujuva navigointi D-Padilla ja numeronäppäimillä."
  },
  {
    "$i": "about_f3",
    "$v": "Erittäin muokattavissa - täydellinen 128-näppäimen pianonäyttö, mukautettavat raidan värit, säädettävät nuotin putoamisnopeudet."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - sisäänrakennettu kevyt syntetisaattori minimoi RAM-muistin käytön halvemmissa laitteissa."
  },
  {
    "$i": "about_keys_title",
    "$v": "Avaimet"
  },
  {
    "$i": "about_k1",
    "$v": "< > haku ±1 s • ^ v äänenvoimakkuus • OK toisto/tauko"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x nopeus • 2 renderöintitila • 3 -0,1x nopeus • 4 kiertoa"
  },
  {
    "$i": "about_k3",
    "$v": "5 latausta MIDI • 6 koko näyttöä • 7 näppäintä 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 selkeää MIDIä (vapaa RAM-muistia) • 9 pianon kokoa • 0 stop"
  },
  {
    "$i": "about_k5",
    "$v": "Puhelutietokortti • * jälki -0,1 • # jälki +0,1 • Lopeta puhelu"
  },
