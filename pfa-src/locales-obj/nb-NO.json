  },
  {
    "$i": "about_desc",
    "$v": "En MIDI-visualisering optimert for smarttelefoner (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Fokuserer på en optimalisert Canvas-gjengivelsespipeline for jevn visning av svarte MIDI-spor med høy tetthet på begrenset maskinvare."
  },
  {
    "$i": "about_features_title",
    "$v": "Nøkkelfunksjoner"
  },
  {
    "$i": "about_f1",
    "$v": "Black MIDI Optimization - lette algoritmer håndterer titusenvis av toner uten alvorlige FPS-fall."
  },
  {
    "$i": "about_f2",
    "$v": "Støtte for fysisk tastatur - jevn navigering via D-Pad og talltaster."
  },
  {
    "$i": "about_f3",
    "$v": "Svært tilpassbar - full 128-tasters pianoskjerm, tilpassbare sporfarger, justerbar notefallshastighet."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - innebygd lettvektssynth minimerer RAM-bruk på low-end enheter."
  },
  {
    "$i": "about_keys_title",
    "$v": "Nøkler"
  },
  {
    "$i": "about_k1",
    "$v": "< > søk ±1s • ^ v volum • OK spill/pause"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x hastighet • 2 gjengivelsesmodus • 3 -0,1x hastighet • 4 rotasjoner"
  },
  {
    "$i": "about_k3",
    "$v": "5 last MIDI • 6 fullskjerm • 7 tangenter 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 klare MIDI (frigjør RAM) • 9 pianostørrelser • 0 stopp"
  },
  {
    "$i": "about_k5",
    "$v": "Samtaleinfokort • * spor -0,1 • # spor +0,1 • Avslutt samtale"
