    "$i": "about_version",
    "$v": "Version 1.0.1 • KaiOS 2.5 • Black MIDI unterstützt • MIT-Lizenz"
  },
  {
    "$i": "about_desc",
    "$v": "Ein für Smartphones optimierter MIDI-Visualizer (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Konzentriert sich auf eine optimierte Canvas-Rendering-Pipeline, um schwarze MIDI-Spuren mit hoher Dichte auf eingeschränkter Hardware reibungslos anzuzeigen."
  },
  {
    "$i": "about_features_title",
    "$v": "Hauptmerkmale"
  },
  {
    "$i": "about_f1",
    "$v": "Black-MIDI-Optimierung – leichte Algorithmen verarbeiten Zehntausende Noten ohne starke FPS-Einbrüche."
  },
  {
    "$i": "about_f2",
    "$v": "Unterstützung für physische Tastaturen – reibungslose Navigation über D-Pad und Zifferntasten."
  },
  {
    "$i": "about_f3",
    "$v": "Hochgradig anpassbar – vollständiges Klavierdisplay mit 128 Tasten, anpassbare Spurfarben, einstellbare Notenfallgeschwindigkeiten."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio-Synthesizer – integrierter, leichter Synthesizer minimiert die RAM-Nutzung auf Low-End-Geräten."
  },
  {
    "$i": "about_keys_title",
    "$v": "Schlüssel"
  },
  {
    "$i": "about_k1",
    "$v": "< > Suche ±1s • ^ v Lautstärke • OK Wiedergabe/Pause"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1-fache Geschwindigkeit • 2 Rendermodus • 3 -0,1-fache Geschwindigkeit • 4 Drehen"
  },
  {
    "$i": "about_k3",
    "$v": "5 MIDI laden • 6 Vollbild • 7 Tasten 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 Clear MIDI (gibt RAM frei) • 9 Piano-Größe • 0 Stop"
  },
  {
    "$i": "about_k5",
    "$v": "Anruf-Infokarte • * Spur -0,1 • # Spur +0,1 • Anruf beenden"
  },
  {
