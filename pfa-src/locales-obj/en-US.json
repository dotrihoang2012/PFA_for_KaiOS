    "$i": "about_version",
    "$v": "Version 1.0.1 • KaiOS 2.5 • Black MIDI supported • MIT License"
  },
  {
    "$i": "about_desc",
    "$v": "A MIDI visualizer optimized for smart feature phones (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Focuses on an optimized Canvas rendering pipeline to smoothly display high-density Black MIDI tracks on constrained hardware."
  },
  {
    "$i": "about_features_title",
    "$v": "Key Features"
  },
  {
    "$i": "about_f1",
    "$v": "<b>Black MIDI Optimization</b> - lightweight algorithms handle tens of thousands of notes without severe FPS drops."
  },
  {
    "$i": "about_f2",
    "$v": "<b>Physical Keypad Support</b> - smooth navigation via D-Pad and number keys."
  },
  {
    "$i": "about_f3",
    "$v": "<b>Highly Customizable</b> - full 128-key piano display, customizable track colors, adjustable note falling speeds."
  },
  {
    "$i": "about_f4",
    "$v": "<b>WebAudio Synthesizer</b> - built-in lightweight synth minimizes RAM usage on low-end devices."
  },
  {
    "$i": "about_keys_title",
    "$v": "Keys"
  },
  {
    "$i": "about_k1",
    "$v": "< > seek ±1s • ^ v volume • OK play/pause"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0.1x speed • 2 render mode • 3 -0.1x speed • 4 rotate"
  },
  {
    "$i": "about_k3",
    "$v": "5 load MIDI • 6 fullscreen • 7 keys 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 clear MIDI (frees RAM) • 9 piano size • 0 stop"
  },
  {
    "$i": "about_k5",
    "$v": "Call info card • * trail -0.1 • # trail +0.1 • End call quit"
  },
  {
    "$i": "about_credits_title",
    "$v": "Credits & Contributing"
  },
  {
    "$i": "about_c1",
    "$v": "Developed by T.Hoang • KaiUI design components"
  },
  {
    "$i": "about_c2",
    "$v": "PRs welcome: fork -> feature branch -> commit -> push -> Pull Request"
  },
  {
    "$i": "about_src",
    "$v": "Source code:<br>github.com/dotrihoang2012/PFA_for_KaiOS<br><br>Released under the MIT License."
  },
