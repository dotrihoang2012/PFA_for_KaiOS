  },
  {
    "$i": "about_f2",
    "$v": "Podrška za fizičku tastaturu - glatka navigacija preko D-Pada i numeričkih tastera."
  },
  {
    "$i": "about_f3",
    "$v": "Visoko prilagodljiv - pun ekran sa 128 tastera za klavir, prilagodljive boje numera, podesive brzine pada nota."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - ugrađeni lagani sintisajzer minimizira upotrebu RAM-a na jeftinijim uređajima."
  },
