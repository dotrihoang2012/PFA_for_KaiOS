    "$i": "about_version",
    "$v": "Versioni 1.0.1 • KaiOS 2.5 • MIDI i zi i mbështetur • Licenca MIT"
  },
  {
    "$i": "about_desc",
    "$v": "Një vizualizues MIDI i optimizuar për telefonat inteligjentë (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Fokusohet në një tubacion të optimizuar të paraqitjes së kanavacës për të shfaqur pa probleme gjurmët MIDI të zeza me densitet të lartë në pajisje të kufizuar."
  },
  {
    "$i": "about_features_title",
    "$v": "Karakteristikat kryesore"
  },
  {
    "$i": "about_f1",
    "$v": "Optimizimi MIDI i zi - algoritme të lehta trajtojnë dhjetëra mijëra shënime pa rënie të rënda të FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Mbështetja fizike e tastierës - navigim i qetë nëpërmjet D-Pad dhe tasteve me numra."
  },
  {
    "$i": "about_f3",
    "$v": "Shumë i personalizueshëm - ekran i plotë i pianos me 128 çelësa, ngjyra të personalizueshme të pjesës, shpejtësi të rregullueshme të rënies së notave."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - sintetizimi i lehtë i integruar minimizon përdorimin e RAM-it në pajisjet e nivelit të ulët."
  },
  {
    "$i": "about_keys_title",
    "$v": "Çelësat"
  },
  {
    "$i": "about_k1",
    "$v": "< > kërko ±1s • ^ v volumi • OK luaj/pauzë"
  },
  {
    "$i": "about_k2",
    "$v": "1 shpejtësi +0,1x • 2 modalitet rendimenti • 3 -0,1x shpejtësi • 4 rrotullim"
  },
  {
    "$i": "about_k3",
    "$v": "5 ngarkim MIDI • 6 ekran të plotë • 7 çelësa 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 MIDI i pastër (RAM pa pagesë) • 9 madhësi piano • 0 ndalesë"
  },
  {
    "$i": "about_k5",
