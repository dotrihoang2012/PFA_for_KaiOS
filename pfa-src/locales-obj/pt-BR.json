    "$i": "about_version",
    "$v": "Versão 1.0.1 • KaiOS 2.5 • Suporte Black MIDI • Licença MIT"
  },
  {
    "$i": "about_desc",
    "$v": "Um visualizador MIDI otimizado para smartphones (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Concentra-se em um pipeline de renderização Canvas otimizado para exibir suavemente faixas Black MIDI de alta densidade em hardware restrito."
  },
  {
    "$i": "about_features_title",
    "$v": "Principais recursos"
  },
  {
    "$i": "about_f1",
    "$v": "Otimização Black MIDI - algoritmos leves lidam com dezenas de milhares de notas sem quedas severas de FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Suporte para teclado físico - navegação suave via D-Pad e teclas numéricas."
  },
  {
    "$i": "about_f3",
    "$v": "Altamente personalizável - display de piano completo com 128 teclas, cores de faixa personalizáveis, velocidades de queda de notas ajustáveis."
  },
  {
    "$i": "about_f4",
    "$v": "Sintetizador WebAudio - sintetizador leve integrado que minimiza o uso de RAM em dispositivos de baixo custo."
  },
  {
    "$i": "about_keys_title",
    "$v": "Chaves"
  },
  {
    "$i": "about_k1",
    "$v": "< > busca ±1s • ^ v volume • OK reproduzir/pausar"
  },
  {
    "$i": "about_k2",
    "$v": "1 velocidade +0,1x • 2 modos de renderização • 3 velocidade -0,1x • 4 rotação"
  },
  {
    "$i": "about_k3",
    "$v": "5 carregar MIDI • 6 tela cheia • 7 teclas 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 MIDI limpo (libera RAM) • 9 tamanho de piano • 0 pontos"
  },
  {
    "$i": "about_k5",
    "$v": "Cartão de informações de chamada • * trilha -0,1 • # trilha +0,1 • Encerrar chamada encerrada"
  },
