    "$i": "about_version",
    "$v": "Versi 1.0.1 • KaiOS 2.5 • Mendukung MIDI Hitam • Lisensi MIT"
  },
  {
    "$i": "about_desc",
    "$v": "Visualisator MIDI yang dioptimalkan untuk ponsel berfitur pintar (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Berfokus pada pipeline rendering Canvas yang dioptimalkan untuk menampilkan track Black MIDI berdensitas tinggi dengan lancar pada perangkat keras yang terbatas."
  },
  {
    "$i": "about_features_title",
    "$v": "Fitur Utama"
  },
  {
    "$i": "about_f1",
    "$v": "Optimasi MIDI Hitam - algoritme ringan menangani puluhan ribu nada tanpa penurunan FPS yang parah."
  },
  {
    "$i": "about_f2",
    "$v": "Dukungan Keypad Fisik - navigasi lancar melalui D-Pad dan tombol angka."
  },
  {
    "$i": "about_f3",
    "$v": "Sangat Dapat Disesuaikan - tampilan piano 128 tuts penuh, warna track yang dapat disesuaikan, kecepatan jatuhnya nada yang dapat disesuaikan."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - synth ringan bawaan meminimalkan penggunaan RAM pada perangkat kelas bawah."
  },
  {
    "$i": "about_keys_title",
    "$v": "Kunci"
  },
  {
    "$i": "about_k1",
    "$v": "< > cari ±1 detik • ^ v volume • OK putar/jeda"
  },
  {
    "$i": "about_k2",
    "$v": "1 Kecepatan +0,1x • 2 mode render • 3 kecepatan -0,1x • 4 putaran"
  },
  {
    "$i": "about_k3",
    "$v": "5 memuat MIDI • 6 layar penuh • 7 tombol 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 clear MIDI (membebaskan RAM) • 9 ukuran piano • 0 stop"
  },
  {
    "$i": "about_k5",
    "$v": "Kartu info panggilan • * jejak -0,1 • # jejak +0,1 • Akhiri panggilan berhenti"
