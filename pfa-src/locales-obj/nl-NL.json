    "$i": "about_version",
    "$v": "Versie 1.0.1 • KaiOS 2.5 • Black MIDI ondersteund • MIT-licentie"
  },
  {
    "$i": "about_desc",
    "$v": "Een MIDI-visualizer geoptimaliseerd voor slimme telefoons (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Richt zich op een geoptimaliseerde Canvas-renderingpijplijn om zwarte MIDI-tracks met hoge dichtheid soepel weer te geven op beperkte hardware."
  },
  {
    "$i": "about_features_title",
    "$v": "Belangrijkste kenmerken"
  },
  {
    "$i": "about_f1",
    "$v": "Black MIDI-optimalisatie - lichtgewicht algoritmen verwerken tienduizenden noten zonder ernstige FPS-dalingen."
  },
  {
    "$i": "about_f2",
    "$v": "Ondersteuning voor fysiek toetsenbord - soepele navigatie via D-Pad en cijfertoetsen."
  },
  {
    "$i": "about_f3",
    "$v": "Zeer aanpasbaar - volledig pianodisplay met 128 toetsen, aanpasbare trackkleuren, instelbare notenvalsnelheden."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - ingebouwde lichtgewicht synth minimaliseert het RAM-gebruik op goedkope apparaten."
  },
  {
    "$i": "about_keys_title",
    "$v": "Sleutels"
  },
  {
    "$i": "about_k1",
    "$v": "< > zoeken ±1s • ^ v volume • OK afspelen/pauzeren"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0,1x snelheid • 2 rendermodus • 3 -0,1x snelheid • 4 roteren"
  },
  {
    "$i": "about_k3",
    "$v": "5 MIDI laden • 6 volledig scherm • 7 toetsen 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 heldere MIDI (maakt RAM vrij) • 9 pianogrootte • 0 stop"
  },
  {
    "$i": "about_k5",
    "$v": "Gespreksinfokaart • * spoor -0,1 • # spoor +0,1 • Gesprek beëindigen"
  },
