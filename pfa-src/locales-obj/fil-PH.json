    "$i": "about_version",
    "$v": "Bersyon 1.0.1 • KaiOS 2.5 �� Black MIDI suportado • MIT License"
  },
  {
    "$i": "about_desc",
    "$v": "Isang MIDI visualizer na na-optimize para sa mga smart feature phone (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Nakatuon sa isang na-optimize na pipeline ng pag-render ng Canvas upang maayos na maipakita ang mga high-density na Black MIDI na track sa limitadong hardware."
  },
  {
    "$i": "about_features_title",
    "$v": "Mga Pangunahing Tampok"
  },
  {
    "$i": "about_f1",
    "$v": "Black MIDI Optimization - ang mga magaan na algorithm ay humahawak ng libu-libong mga tala nang walang malubhang pagbaba ng FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Suporta sa Pisikal na Keypad - maayos na nabigasyon sa pamamagitan ng D-Pad at mga number key."
  },
  {
    "$i": "about_f3",
    "$v": "Lubos na Nako-customize - buong 128-key na piano display, nako-customize na mga kulay ng track, adjustable na bilis ng pagbagsak ng tala."
  },
  {
    "$i": "about_f4",
    "$v": "WebAudio Synthesizer - pinapaliit ng built-in na lightweight synth ang paggamit ng RAM sa mga low-end na device."
  },
  {
    "$i": "about_keys_title",
    "$v": "Mga susi"
  },
  {
    "$i": "about_k1",
    "$v": "< > humanap ng ±1s • ^ v volume • OK play/pause"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0.1x na bilis • 2 render mode • 3 -0.1x na bilis • 4 na pag-ikot"
  },
  {
    "$i": "about_k3",
    "$v": "5 load MIDI • 6 fullscreen • 7 key 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 malinaw na MIDI (nagpapalaya ng RAM) • 9 na laki ng piano • 0 stop"
  },
  {
    "$i": "about_k5",
    "$v": "Card ng impormasyon ng tawag • * trail -0.1 • # trail +0.1 • End call quit"
  },
  {
    "$i": "about_credits_title",
    "$v": "Mga Kredito at Pag-aambag"
  },
  {
    "$i": "about_c1",
    "$v": "Binuo ng T.Hoang • mga bahagi ng disenyo ng KaiUI"
  },
  {
    "$i": "about_c2",
    "$v": "Malugod na tinatanggap ang mga PR: fork -> feature branch -> commit -> push -> Pull Request"
  },
  {
    "$i": "about_src",
    "$v": "Source code: github.com/dotrihoang2012/PFA_for_KaiOS. Inilabas sa ilalim ng Lisensya ng MIT."
  },
