    "$i": "about_version",
    "$v": "Inguqulo 1.0.1 • I-KaiOS 2.5 • I-MIDI emnyama isekelwe • Ilayisensi ye-MIT"
  },
  {
    "$i": "about_desc",
    "$v": "Isibonisi se-MIDI esenzelwe amafoni ahlakaniphile (Nokia 2720 Flip, 8000 4G, 6300 4G, 8110 4G, JioPhone...). Igxile epayipini lokunikezela leCanvas elilungiselelwe ukuze libonise ngokushelelayo amathrekhi ama-Black MIDI aphezulu kuhadiwe evinjiwe."
  },
  {
    "$i": "about_features_title",
    "$v": "Izici Eziyinhloko"
  },
  {
    "$i": "about_f1",
    "$v": "I-Black MIDI Optimization - ama-algorithms angasindi aphatha amashumi ezinkulungwane zamanothi ngaphandle kokwehla okukhulu kwe-FPS."
  },
  {
    "$i": "about_f2",
    "$v": "Ukusekelwa Kwekhiphedi Engokoqobo - ukuzulazula okushelelayo nge-D-Pad nezinkinobho zezinombolo."
  },
  {
    "$i": "about_f3",
    "$v": "Ekwenzeke ngokwezifiso Kakhulu - isibonisi sepiyano esigcwele okhiye abangu-128, imibala yethrekhi ehlelwa ngendlela oyifisayo, isivinini esishintshayo senothi esiwayo."
  },
  {
    "$i": "about_f4",
    "$v": "I-WebAudio Synthesizer - i-synthes ye-lightweight eyakhelwe ngaphakathi inciphisa ukusetshenziswa kwe-RAM kumadivayisi asezingeni eliphansi."
  },
  {
    "$i": "about_keys_title",
    "$v": "Okhiye"
  },
  {
    "$i": "about_k1",
    "$v": "< > funa ±1s • ^ v ivolumu • KULUNGILE dlala/misa kancane"
  },
  {
    "$i": "about_k2",
    "$v": "1 +0.1x isivinini • 2 imodi yokunikezela • 3 -0.1x isivinini • 4 zungezisa"
  },
  {
    "$i": "about_k3",
    "$v": "5 layisha i-MIDI • 6 isikrini esigcwele • 7 okhiye 88-128"
  },
  {
    "$i": "about_k4",
    "$v": "8 i-MIDI ecacile (ikhulula i-RAM) • 9 usayizi wepiyano • 0 isitobhi"
  },
  {
    "$i": "about_k5",
    "$v": "Ikhadi lolwazi lwekholi • * umkhondo -0.1 • # umkhondo +0.1 • Qeda ukuyeka ucingo"
  },
