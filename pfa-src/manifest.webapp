  "chrome": {
    "navigation": false
  },
  "permissions": {
    "device-storage:sdcard": {
      "access": "readwrite"
    },
    "audio-channel-content": {},
    "volumemanager": {},
    "desktop-notification": {}
  },
  "activities": {
    "open": {
      "filters": {
        "filename": {
          "pattern": ".*(mid$|MID$|midi$|MIDI$|note$|NOTE$)",
          "patternFlags": "gi"
        }
      },
      "href": "/index.html",
      "disposition": "window",
      "returnValue": true
    },
    "share": {
      "filters": {
        "filenames": {
          "pattern": ".*(mid$|MID$|midi$|MIDI$|note$|NOTE$)",
          "patternFlags": "gi"
        }
      },
      "href": "/index.html",
      "disposition": "window",
      "returnValue": true
    }
  },
  "categories": [
    "entertainment",
    "utilities"
  ],
  "messages": [
    {
      "activity": "/index.html"
    }
  ]
}