{
  "name": "Piano From Above (BETA)",
  "description": "MIDI player with keyboard visualization.",
  "launch_path": "/index.html",
  "developer": {
    "name": "T.Hoang",
    "url": "https://github.com/dotrihoang2012"
  },
  "icons": {
    "46": "/icons/piano_56.png",
    "112": "/icons/piano_112.png"
  },
  "default_locale": "en-US",
  "fullscreen": false,
  "orientation": ["portrait-primary", "portrait-secondary", "landscape-primary", "landscape-secondary"],
  "version": "1.0.1",
  "type": "privileged",
  "theme_color": "#0a9bf5",
  "locales": {
    "en-US": {
      "name": "Piano From Above",
      "subtitle": "MIDI Player with keyboard Visualization",
      "description": "A MIDI player with live piano visuals. Open any .mid or .note and watch the keys as it plays."
    }
  },
  "chrome": {
    "navigation": false
  },
  "permissions": {
    "device-storage:sdcard": {
      "access": "readwrite"
    },
    "audio-channel-content": {},
    "desktop-notification": {}
  },
  "activities": {
    "open": {
      "filters": {
        "filename": {
          "pattern": ".*(mid$|MID$|midi$|MIDI$|note$|NOTE$)",
          "patternFlags": "gi"
        }
      },
      "href": "/index.html",
      "disposition": "inline",
      "returnValue": true
    },
    "share": {
      "filters": {
        "filenames": {
          "pattern": ".*(mid$|MID$|midi$|MIDI$|note$|NOTE$)",
          "patternFlags": "gi"
        }
      },
      "href": "/index.html",
      "disposition": "window",
      "returnValue": true
    }
  },
  "categories": [
    "utilities"
  ],
  "messages": [
    { "activity": "/index.html" }
  ]
}
