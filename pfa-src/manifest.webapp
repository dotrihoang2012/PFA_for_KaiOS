{
  "name": "PFA (BETA)",
  "description": "MIDI player with keyboard visualization.",
  "launch_path": "/index.html",
  "developer": {
    "name": "T.Hoang",
    "url": "https://github.com/dotrihoang2012"
  },
  "icons": {
    "46": "/style/icons/piano_56.png",
    "112": "/style/icons/piano_112.png"
  },
  "default_locale": "en-US",
  "fullscreen": false,
  "orientation": [
    "portrait-primary",
    "portrait-secondary",
    "portrait",
    "landscape-primary",
    "landscape-secondary",
    "landscape"
  ],
  "version": "1.0.2",
  "type": "privileged",
  "precompile": [
    "js/ads/kaiads.v5.min.js",
    "js/utils/constants.js",
    "js/utils/mozL10n.js",
    "js/utils/l10n.js",
    "js/utils/storage.js",
    "js/utils/writes.js",
    "js/audio/sfparser.js",
    "js/utils/sfscan.js",
    "js/midi/streamParser.js",
    "js/midi/noteStream.js",
    "js/midi/tempo.js",
    "js/midi/midiParser.js",
    "js/midi/sequencer.js",
    "js/audio/synth.js",
    "js/audio/soundbank.js",
    "js/render/keyboard.js",
    "js/render/notebuffer.js",
    "js/render/notes.js",
    "js/render/hud.js",
    "js/store/state.js",
    "js/input/bindings.js",
    "js/ui/settings.js",
    "js/utils/noteWriter.js",
    "js/input/controls.js",
    "js/ads/kaiads.js",
    "js/main.js"
  ],
  "dependencies": {
    "ads-sdk": "1.5.8"
  },
  "theme_color": "#0a9bf5",
