{
  "lang": "ne-IN",
  "name": "Piano From Above",
  "id": "PFA (BETA)",
  "short_name": "PFA",
  "categories": [
    "entertainment",
    "utilities"
  ],
  "description": "लाइभ पियानो भिजुअलहरूसँग एक MIDI प्लेयर।",
  "icons": [
    {
      "src": "/style/icons/piano_56.png",
      "type": "image/png",
      "sizes": "56x56"
    },
    {
      "src": "/style/icons/piano_112.png",
      "type": "image/png",
      "sizes": "112x112"
    }
  ],
  "start_url": "/index.html",
  "theme_color": "#0a9bf5",
  "background_color": "#0a0a0a",
  "orientation": "any",
  "b2g_features": {
    "version": "1.1",
    "type": "privileged",
    "core": false,
    "subtitle": "कीबोर्ड भिजुअलाइजेशनको साथ MIDI प्लेयर",
    "origin": "pfa",
    "developer": {
      "name": "T.Hoang",
      "url": "https://github.com/dotrihoang2012"
    },
    "permissions": {
      "device-storage:sdcard": {
        "access": "readwrite"
      },
      "audio-channel-content": {},
      "volumemanager": {},
      "desktop-notification": {},
      "systemXHR": {}
    },
    "chrome": {
      "navigation": false
    },
    "focus_color": "#0a9bf5",
    "activities": {
      "open": {
        "filters": {
          "filename": {
            "pattern": ".*(mid$|MID$|midi$|MIDI$|note$|NOTE$)",
            "patternFlags": "gi"
          }
        },
        "returnValue": true
      },
      "import": {
        "filters": {
          "filename": {
            "pattern": ".*(mid$|MID$|midi$|MIDI$|note$|NOTE$)",
            "patternFlags": "gi"
          }
        },
        "returnValue": true
      },
      "share": {
        "filters": {
          "filenames": {
            "pattern": ".*(mid$|MID$|midi$|MIDI$|note$|NOTE$)",
            "patternFlags": "gi"
          }
        },
        "returnValue": true
      }
    }
  },
  "serviceworker": {
    "script_url": "sw.js"
  },
  "messages": [
    "activity"
  ]
}
